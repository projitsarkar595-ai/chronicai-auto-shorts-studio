{
  "name": "chronicai-auto-shorts-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run server\" \"npm run client\"",
    "server": "node --watch-path=backend --watch backend/server.js",
    "client": "npm --prefix frontend run dev",
    "start": "node backend/server.js",
    "test": "node --test tests/*.test.js",
    "build": "npm --prefix frontend run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "googleapis": "^156.0.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
